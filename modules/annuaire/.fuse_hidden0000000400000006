<!DOCTYPE html>
<!-- DBM | Surface: MODULE | Auth: bdb-shell.js | Shell: oui -->
<html lang="fr">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Annuaire Equipe — Des Blocs &amp; Moi</title>

  <!-- BLOC E CSS — Chaîne V5.1 (CONV-CHAIN-E) -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"/>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet"/>
  <link href="../../css/dbm-theme.css" rel="stylesheet"/>
  <link href="../../css/bdb-ui-kit.css" rel="stylesheet"/>
  <link href="../../css/dbm-module-color.css" rel="stylesheet"/>
  <link href="annuaire-ui.css" rel="stylesheet"/>

  <!-- CONV-MODAL-08 : cascade variables couleur module sur :root pour modales (BS5 portal hors wrapper) -->
  <style>
    :root {
      --module-color: #86efac;
      --module-color-strong: #4ade80;
      --module-color-text: #14532d;
      --module-color-soft: rgba(134, 239, 172, 0.15);
    }
  </style>
</head>

<body class="sidebar-closed">

  <div id="wrapper">

    <!-- INTERDIT-E1 : #bdb-shell premier enfant de #wrapper -->
    <div id="bdb-shell"
         data-module-title="Annuaire"
         data-module-icon="bi-people"
         data-root-path="../../"
         data-login-mode="modal"
         data-shell-theme="dbm">
    </div>

    <div id="wrapper_content">
      <div class="app-layout">
        <main class="app-main" id="main-content">
          <div class="app-content" data-module-color="equipe" style="--module-color:#86efac;--module-color-strong:#4ade80;--module-color-text:#14532d;--module-color-soft:rgba(134,239,172,0.15)">

            <!-- Breadcrumb -->


            <section class="app-zone" data-zone="Breadcrumb">
              <nav class="app-breadcrumb" aria-label="Fil d'Ariane">
              <a href="../../index.html">Accueil</a>
              <span class="app-breadcrumb-sep"><i class="bi bi-chevron-right"></i></span>
              <span>Annuaire</span>
            </nav>


            </section>

            <!-- Slot admin (visible si isAdmin via bdb-shell) -->
            <section class="app-zone" data-zone="Page Title">

              <!-- Bandeau colore module — gradient via variables module -->
            <div class="p-4 rounded shadow-sm mb-4 ann-page-banner">
              <h1 class="mb-2 fw-bold"><i class="bi bi-people me-2"></i>Annuaire Équipe</h1>
              <p class="mb-0 ann-page-subtitle" id="heroCount">Membres de l'équipe du bloc opératoire</p>
            </div>

            </section>

            <!-- Filters (toolbar standard : input-group flex-grow + select 180px + CTA 180px) -->
            <section class="app-zone" data-zone="Filters">
              <div class="ann-toolbar-bar">
                <div class="row g-2 align-items-center">
                  <div class="col">
                    <div class="input-group input-group-sm">
                      <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                      <input class="form-control border-start-0 ann-search-input" type="search" id="searchInput" placeholder="Rechercher par nom..." autocomplete="off"/>
                    </div>
                  </div>
                  <div class="col-auto ann-toolbar-select">
                    <select class="form-select form-select-sm" id="filterFn" aria-label="Filtrer par fonction">
                      <option value="all" selected>Toutes fonctions</option>
                      <option value="medecin">Médecins</option>
                      <option value="cadre">Cadres</option>
                      <option value="infirmier">Infirmiers</option>
                      <option value="aide-soignant">Aides-soignants</option>
                    </select>
                  </div>
                  <div class="col-auto d-none ann-toolbar-cta" id="adminAddSlot">
                    <button class="btn btn-module btn-sm w-100" id="btnAddMember">
                      <i class="bi bi-person-plus me-1"></i>Ajouter membre
                    </button>
                  </div>
                </div>
              </div>
            </section>

            <!-- Content (grille membres + empty state) -->
            <section class="app-zone" data-zone="Content">

              <!-- Grid membres (rendu JS) -->
              <div id="loadingState" class="d-none">
                <div class="placeholder-glow"><div class="placeholder col-6 rounded mb-2"></div></div>
              </div>
              <div id="errorState" class="app-empty d-none">
                <i class="bi bi-wifi-off"></i>
                <p class="ann-empty-text">Erreur de chargement</p>
              </div>
              <div id="membersGrid" class="members-grid" aria-live="polite"></div>

              <!-- Empty state -->
              <div id="emptyState" class="app-empty ann-empty-state d-none">
                <i class="bi bi-people ann-empty-icon"></i>
                <p class="ann-empty-title">Aucun membre trouvé</p>
                <small id="emptyMsg" class="ann-empty-help">L'annuaire est vide.</small>
              </div>
            </section>

          </div><!-- /app-content -->

          <footer class="app-footer">
            <small>&copy; 2026 <span class="app-nom"></span></small>
          </footer>

        </main>
      </div><!-- /app-layout -->
    </div><!-- /wrapper_content -->

  </div><!-- /wrapper -->

  <!-- ═══════ MODALES (hors #wrapper) ═══════ -->

  <!-- MODALE MEMBRE -->
  <div class="modal fade" id="modalMembre" tabindex="-1" aria-labelledby="modalMembreLabel">
    <div class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable annuaire-modal-membre-dialog modal-fullscreen-md-down">
      <div class="modal-content rounded-4 border-0 shadow-lg">
        <div class="modal-header modal-header-module">
          <h5 class="modal-title" id="modalMembreLabel">
            <i class="bi bi-person-circle me-2"></i>Profil
          </h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
        </div>
        <div class="modal-body annuaire-modal-membre-body" id="modalMembreBody"></div>
      </div>
    </div>
  </div>

  <!-- MODALE GANT -->
  <div class="modal fade ann-modal-l2" id="modalGant" tabindex="-1" aria-labelledby="modalGantTitle">
    <div class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable annuaire-modal-equip-dialog modal-fullscreen-md-down">
      <div class="modal-content rounded-4 border-0 shadow-lg">
        <div class="modal-header modal-header-module">
          <h5 class="modal-title" id="modalGantTitle">
            <i class="bi bi-hand-index me-2"></i>Gants
          </h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
        </div>
        <div class="modal-body" id="modalGantBody">
          <div class="text-center py-3"><div class="spinner-border spinner-border-sm text-secondary"></div></div>
        </div>
      </div>
    </div>
  </div>

  <!-- MODALE CASAQUE -->
  <div class="modal fade ann-modal-l2" id="modalCasaque" tabindex="-1" aria-labelledby="modalCasaqueTitle">
    <div class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable annuaire-modal-equip-dialog modal-fullscreen-md-down">
      <div class="modal-content rounded-4 border-0 shadow-lg">
        <div class="modal-header modal-header-module">
          <h5 class="modal-title" id="modalCasaqueTitle">
            <i class="bi bi-person-badge me-2"></i>Casaque
          </h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
        </div>
        <div class="modal-body" id="modalCasaqueBody">
          <div class="text-center py-3"><div class="spinner-border spinner-border-sm text-secondary"></div></div>
        </div>
      </div>
    </div>
  </div>

  <!-- MODALE CONFIRMATION SUPPRESSION -->
  <div class="modal fade ann-modal-l3" id="modalConfirmDelete" tabindex="-1" aria-labelledby="modalConfirmDeleteLabel">
    <div class="modal-dialog modal-dialog-centered modal-fullscreen-md-down">
      <div class="modal-content rounded-4 border-0 shadow-lg">
        <div class="modal-header modal-header-module">
          <h5 class="modal-title" id="modalConfirmDeleteLabel">
            <i class="bi bi-exclamation-triangle me-2"></i>Confirmer la suppression
          </h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
        </div>
        <div class="modal-body">
          <p id="deleteConfirmMsg" class="mb-0">Supprimer cet utilisateur ?</p>
        </div>
        <div class="modal-footer">
          <button class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Annuler</button>
          <button class="btn btn-danger btn-sm" id="btnConfirmDelete">Supprimer</button>
        </div>
      </div>
    </div>
  </div>

  <!-- TOAST — pattern bdbToast (bdb-ui.js) — CONV-CHAIN-E V5.1 -->
  <div class="toast-container position-fixed bottom-0 end-0 p-3">
    <div id="toastMsg" class="toast align-items-center text-bg-success border-0" role="alert" aria-live="assertive" aria-atomic="true">
      <div class="d-flex">
        <div class="toast-body" id="toastText">Message</div>
        <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Fermer"></button>
      </div>
    </div>
  </div>

  <!-- SCRIPTS — Chaîne JS V5 -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="../../js/bdb-modal-a11y.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2/dist/umd/supabase.js"></script>
  <script src="../../js/supabase-client.js"></script>
  <script src="../../js/bdb-ui.js"></script>
  <script src="../../js/bdb-invite-guard.js"></script>
  <script src="../../js/bdb-shell.js"></script>
  <script src="../../js/bdb-demo.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/fuse.js@7.0.0/dist/fuse.min.js"></script>
  <script src="../../js/bdb-search.js"></script>
  <script src="annuaire-app.js"></script>
  <!-- PWA en fin de chaîne (CONV-CHAIN-E V5) -->
  <script src="../../js/bdb-pwa.js"></script>

</body>
</html>
