<!DOCTYPE html>
<!-- BDB | Surface: MODULE | Auth: bdb-shell.js | Shell: oui -->
<html lang="fr" data-bs-theme="light">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Transmissions — Administration</title>

  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/menywise/BDB@63905396c73b061f336f8f5178d738627bca601c/theme-base.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
  <link rel="stylesheet" href="../../css/cds-overrides.css">
  <link rel="stylesheet" href="transmissions-ui.css">
</head>
<body>

<div id="wrapper" class="d-flex align-items-stretch flex-column min-vh-100">

  <!-- SHELL BDB (INTERDIT-E1 : premier enfant de main) -->
  <div id="bdb-shell"
       data-module-title="Transmissions — Administration"
       data-module-icon="bi-chat-square-text"
       data-root-path="../../"
       data-login-mode="modal"
       data-shell-kind="backoffice">
  </div>

    <div id="wrapper_content" class="d-flex flex-fill">
      <main id="middle" class="flex-fill">
      <div class="container-fluid flex-grow-1 p-0" id="transAdminApp">

    <div class="d-flex align-items-center gap-2 px-3 py-2 border-bottom">
      <a href="../admin/index.html" class="btn btn-sm btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i>Administration
      </a>
      <span class="text-muted">›</span>
      <span class="small fw-medium">
        <i class="bi bi-chat-square-text me-1 text-primary"></i>Transmissions
      </span>
    </div>

    <!-- ── NAV TABS ────────────────────────────────────────── -->
    <ul class="nav nav-tabs px-3 pt-2" id="trans-admin-tabs" role="tablist">
      <li class="nav-item" role="presentation">
        <button class="nav-link active" id="tab-trans-list"
                data-bs-toggle="tab" data-bs-target="#panel-trans-list"
                type="button" role="tab">
          <i class="bi bi-list-ul me-1"></i>Toutes les transmissions
        </button>
      </li>
      <li class="nav-item" role="presentation">
        <button class="nav-link" id="tab-trans-stats"
                data-bs-toggle="tab" data-bs-target="#panel-trans-stats"
                type="button" role="tab">
          <i class="bi bi-bar-chart me-1"></i>Stats
        </button>
      </li>
      <li class="nav-item" role="presentation">
        <button class="nav-link" id="tab-trans-export"
                data-bs-toggle="tab" data-bs-target="#panel-trans-export"
                type="button" role="tab">
          <i class="bi bi-download me-1"></i>Export
        </button>
      </li>
    </ul>

    <!-- ── TAB CONTENT ───────────────────────────────────── -->
    <div class="tab-content px-3 pt-3" id="trans-admin-tab-content">

      <!-- ═══════════════════════════════════════════════════
           PANEL 1 — LISTE
           ═══════════════════════════════════════════════════ -->
      <div class="tab-pane fade show active" id="panel-trans-list" role="tabpanel">

        <!-- Toolbar filtres -->
        <div class="d-flex gap-2 flex-wrap mb-3">
          <select class="form-select form-select-sm trans-admin-filter" id="filter-trans-status">
            <option value="">Tous les statuts</option>
            <option value="published">Publiées</option>
            <option value="draft">Brouillons</option>
          </select>
          <select class="form-select form-select-sm trans-admin-filter" id="filter-trans-cat">
            <option value="">Toutes catégories</option>
          </select>
          <input type="text" class="form-control form-control-sm trans-admin-search"
                 id="filter-trans-search" placeholder="Rechercher...">
        </div>

        <!-- État : chargement -->
        <div id="trans-list-loading" class="py-4">
          <div class="placeholder-glow">
            <span class="placeholder col-12 mb-2"></span>
            <span class="placeholder col-10 mb-2"></span>
            <span class="placeholder col-8"></span>
          </div>
        </div>

        <!-- État : vide -->
        <div id="trans-list-empty" class="text-center py-5 d-none">
          <i class="bi bi-inbox fs-2 text-muted d-block mb-2"></i>
          <p class="text-muted">Aucune transmission pour ce filtre.</p>
        </div>

        <!-- État : erreur -->
        <div id="trans-list-error" class="alert alert-danger d-none">
          <i class="bi bi-exclamation-triangle me-2"></i>
          <span id="trans-list-error-msg"></span>
          <button class="btn btn-sm btn-outline-danger ms-2" id="btn-trans-list-retry">Réessayer</button>
        </div>

        <!-- État : tableau -->
        <div id="trans-list-table" class="d-none">
          <div class="table-responsive">
            <table class="table table-hover table-sm align-middle">
              <thead class="table-light">
                <tr>
                  <th>Titre</th>
                  <th>Auteur</th>
                  <th>Catégorie</th>
                  <th>Statut</th>
                  <th class="bo-th-md">Date</th>
                  <th class="bo-th-xs">Action</th>
                </tr>
              </thead>
              <tbody id="trans-list-tbody"></tbody>
            </table>
          </div>
        </div>

      </div><!-- /panel-trans-list -->

      <!-- ═══════════════════════════════════════════════════
           PANEL 2 — STATS
           ═══════════════════════════════════════════════════ -->
      <div class="tab-pane fade" id="panel-trans-stats" role="tabpanel">

        <!-- État : chargement -->
        <div id="trans-stats-loading" class="py-4">
          <div class="placeholder-glow">
            <span class="placeholder col-8 mb-2"></span>
            <span class="placeholder col-6"></span>
          </div>
        </div>

        <!-- État : erreur -->
        <div id="trans-stats-error" class="alert alert-danger d-none">
          <i class="bi bi-exclamation-triangle me-2"></i>
          <span id="trans-stats-error-msg"></span>
        </div>

        <!-- État : contenu -->
        <div id="trans-stats-content" class="d-none">
          <div class="row g-3 mb-4">
            <div class="col-6 col-md-3">
              <div class="card text-center">
                <div class="card-body">
                  <div class="trans-admin-kpi" id="kpi-trans-total">—</div>
                  <div class="small text-muted">Total</div>
                </div>
              </div>
            </div>
            <div class="col-6 col-md-3">
              <div class="card text-center border-success">
                <div class="card-body">
                  <div class="trans-admin-kpi text-success" id="kpi-trans-published">—</div>
                  <div class="small text-muted">Publiées</div>
                </div>
              </div>
            </div>
            <div class="col-6 col-md-3">
              <div class="card text-center border-warning">
                <div class="card-body">
                  <div class="trans-admin-kpi text-warning" id="kpi-trans-draft">—</div>
                  <div class="small text-muted">Brouillons</div>
                </div>
              </div>
            </div>
            <div class="col-6 col-md-3">
              <div class="card text-center">
                <div class="card-body">
                  <div class="trans-admin-kpi text-muted" id="kpi-trans-dev">—</div>
                  <div class="small text-muted">Données dev</div>
                </div>
              </div>
            </div>
          </div>
        </div>

      </div><!-- /panel-trans-stats -->

      <!-- ═══════════════════════════════════════════════════
           PANEL 3 — EXPORT
           ═══════════════════════════════════════════════════ -->
      <div class="tab-pane fade" id="panel-trans-export" role="tabpanel">
        <div class="py-3">
          <p class="text-muted mb-3">
            Export de toutes les transmissions (titre, statut, catégorie, date).<br>
            Le contenu n'est pas exporté (RGPD).
          </p>
          <button class="btn btn-outline-primary" id="btn-trans-export-csv">
            <i class="bi bi-file-earmark-spreadsheet me-1"></i>Télécharger CSV
          </button>
        </div>
      </div><!-- /panel-trans-export -->

    </div><!-- /.tab-content -->

  </div><!-- /#transAdminApp -->

  <!-- ══════════════════════════════════════════════════════════
       MODALE PREVIEW (lecture seule — posture modération)
       ══════════════════════════════════════════════════════════ -->
  <div class="modal fade" id="modal-trans-preview" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" id="modal-trans-preview-title">Transmission</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <div id="modal-trans-preview-content" class="trans-admin-preview-content"></div>
        </div>
        <div class="modal-footer d-flex justify-content-between">
          <button type="button" class="btn btn-danger btn-sm" id="btn-trans-delete-confirm">
            <i class="bi bi-trash me-1"></i>Supprimer cette transmission
          </button>
          <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Fermer</button>
        </div>
      </div>
    </div>
  </div>

    <footer class="mt-auto py-3 border-top text-center text-muted bg-white">
      <small>&copy; 2026 <span class="app-nom"></span> — <span class="badge bg-light text-dark border">CDS Compliant</span></small>
    </footer>

</div><!-- /wrapper -->

<!-- ── SCRIPTS (ordre obligatoire) ───────────────────────── -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="../../js/bdb-modal-a11y.js"></script>
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2/dist/umd/supabase.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/dompurify/3.0.6/purify.min.js"></script>
<script src="../../js/supabase-client.js"></script>
<script src="../../js/bdb-ui.js"></script>
<script src="../../js/bdb-invite-guard.js"></script>
<script src="../../js/bdb-shell.js"></script>
<script src="transmissions-admin.js"></script>

</body>
</html>
