/* ─── MODALE CONFIRMATION (E2 — remplace confirm() natif) ── */
function showConfirm({ title, msg, btnLabel, btnClass, onConfirm }) {
  document.getElementById('transConfirmTitle').textContent = title;
  document.getElementById('transConfirmMsg').textContent   = msg;
  const btn = document.getElementById('btnTransConfirmAction');
  btn.textContent  = btnLabel;
  btn.className    = `btn btn-sm ${btnClass}`;
  // Nettoyer les anciens listeners
  const newBtn = btn.cloneNode(true);
  btn.parentNode.replaceChild(newBtn, btn);
  newBtn.addEventListener('click', () => {
    modalConfirm.hide();
    onConfirm();
  });
  modalConfirm.show();
}

/* ─── INIT FROM SHELL (A5 CORRIGÉ — remplace initAuth() local) ── */
function initFromShell() {
  state.isAdmin    = window.bdbUser?.isAdmin ?? false;
  state.userId     = window.bdbUser?.id ?? null;
  state.isApproved = window.bdbUser?.isAdmin || window.bdbUser?.role === 'membre';

  // E3 CORRIGÉ : slot admin dans toolbar — pas de createElement (INTERDIT-C4)
  if (state.isApproved) {
    document.getElementById('transToolbarAdminSlot').classList.remove('d-none');
