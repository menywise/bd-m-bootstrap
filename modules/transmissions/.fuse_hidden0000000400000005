/* ─── CONTENT TYPE ID ────────────────────────────────────── */
async function loadContentTypeId() {
  const { data, error } = await DB.from('content_types').select('id').eq('code', 'transmissions').maybeSingle();
  if (error) throw error;
  state.contentTypeId = data?.id || null;
}

/* ─── CATEGORIES ─────────────────────────────────────────── */
async function loadCategories() {
  let q = DB.from('categories').select('*').eq('active', true).order('label');
  if (state.contentTypeId) q = q.eq('content_type_id', state.contentTypeId);
  const { data, error } = await q;
  if (error) throw error;
  state.categories = data || [];
  const filterSel = document.getElementById('filterCategory');
  const formSel   = document.getElementById('formCategory');
  state.categories.forEach(cat => {
    filterSel.add(new Option(cat.label, cat.id));
    formSel.add(new Option(cat.label, cat.id));
  });
}

/* ─── TAGS ───────────────────────────────────────────────── */
async function loadTags() {
  const TYPES = ['libre','fonction','anatomie','intervention','materiel','personne','marque'];
  const { data, error } = await DB.from('tags')
    .select('id, label_display, label_normalized, type')
    .in('type', TYPES).eq('is_locked', false).order('label_display');
  /* Bug B2 : GET /tags → 400 possible (colonne type cloud). Warning, pas crash. */
  if (error) return;
  state.allTags = data || [];
}

async function syncTags(transmissionId, tagIds) {
  const { error: delErr } = await DB.from('tag_links').delete().eq('content_type', 'transmission').eq('content_id', transmissionId).select(); // UX06 : caller confirms
  if (tagIds.length > 0) {
    const payload = tagIds.map(tid => ({ content_type: 'transmission', content_id: transmissionId, tag_id: tid }));
    await DB.from('tag_links').insert(payload).select();
  }
}

/* ─── STATS ──────────────────────────────────────────────── */
async function loadStats() {
  const [r1, r2, r3, r4] = await Promise.all([
    DB.from('transmissions').select('id', { count: 'exact', head: true }).eq('status', 'open'),
    DB.from('transmissions').select('id', { count: 'exact', head: true }).eq('status', 'archived'),
    DB.from('transmissions').select('id', { count: 'exact', head: true }).eq('priority', true).eq('status', 'open'),
    DB.from('transmissions').select('id', { count: 'exact', head: true }).eq('type', 'essentiel').eq('status', 'open'),
  ]);
  document.getElementById('statOpen').textContent     = r1.count ?? 0;
  document.getElementById('statArchived').textContent = r2.count ?? 0;
  document.getElementById('statPriority').textContent = r3.count ?? 0;
  document.getElementById('statEssential').textContent = (r4.count ?? 0) + '/20';
}

/* ─── SIGNED URL — D1 CORRIGÉ : 3600 → 900 ──────────────── */
async function getSignedUrl(storagePath) {
  if (!storagePath) return null;
  const { data } = await DB.storage.from('content-images').createSignedUrl(storagePath, 900);
  return data?.signedUrl || null;
}

