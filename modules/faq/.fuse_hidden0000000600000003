<!DOCTYPE html>
<!-- DBM | Surface: ADMIN | Auth: admin uniquement | Shell: oui -->
<html lang="fr" data-bs-theme="light">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>FAQ — Administration</title>

  <!-- BLOC E CSS — Chaîne V5.1 (CONV-CHAIN-E) -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"/>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet"/>
  <link href="../../css/dbm-theme.css" rel="stylesheet"/>
  <link href="../../css/bdb-ui-kit.css" rel="stylesheet"/>
  <link href="../../css/dbm-module-color.css" rel="stylesheet"/>
  <link href="faq-ui.css" rel="stylesheet"/>

  <!-- Variables couleur module (CONV-MODULE-COLOR-02) -->
  <style>
    :root {
      --module-color: #c4b5fd;
      --module-color-strong: #a78bfa;
      --module-color-text: #4c1d95;
      --module-color-soft: rgba(196, 181, 253, 0.15);
    }
  </style>
</head>

<body>

  <div id="wrapper" class="d-flex align-items-stretch flex-column min-vh-100">

  <div id="bdb-shell"
       data-module-title="FAQ — Administration"
       data-module-icon="bi-question-circle"
       data-root-path="../../"
       data-shell-kind="backoffice"
       data-login-mode="modal"
       data-shell-theme="dbm">
  </div>

    <div id="wrapper_content" class="d-flex flex-fill">
      <main id="middle" class="flex-fill">
      <!-- Tabs nav -->
  <div class="container-fluid p-0">
    <div class="d-flex align-items-center gap-2 px-3 py-2 border-bottom">
      <a href="../admin/index.html" class="btn btn-sm btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i>Administration
      </a>
      <span class="text-muted">›</span>
      <span class="small fw-medium">
        <i class="bi bi-question-circle me-1"></i>FAQ
      </span>
    </div>
    <ul class="nav bdb-tabs px-3 pt-2" id="faqAdminTabs" role="tablist">
      <li class="nav-item" role="presentation">
        <button class="nav-link active" id="tab-entries-btn"
          data-bs-toggle="tab" data-bs-target="#tab-entries"
          type="button" role="tab">
          <i class="bi bi-list-ul me-1"></i>Toutes les entrées
          <span class="badge bg-secondary-subtle text-secondary ms-1" id="kpiTotal">—</span>
        </button>
      </li>
      <li class="nav-item" role="presentation">
        <button class="nav-link" id="tab-drafts-btn"
          data-bs-toggle="tab" data-bs-target="#tab-drafts"
          type="button" role="tab">
          <i class="bi bi-hourglass me-1"></i>Brouillons membres
          <span class="badge bg-warning-subtle text-warning ms-1" id="kpiDraft">—</span>
        </button>
      </li>
    </ul>
  </div>

  <div class="tab-content flex-grow-1">

    <!-- ── TAB 1 : Toutes les entrées ── -->
    <div class="tab-pane fade show active" id="tab-entries" role="tabpanel">
      <div class="container-fluid p-4">

        <!-- KPIs -->
        <div class="row g-3 mb-4">
          <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm text-center py-3">
              <div class="faq-admin-kpi text-primary" id="kpiTotalCard">—</div>
              <div class="text-muted small">Entrées total</div>
            </div>
          </div>
          <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm text-center py-3">
              <div class="faq-admin-kpi text-success" id="kpiActive">—</div>
              <div class="text-muted small">Actives</div>
            </div>
          </div>
          <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm text-center py-3">
              <div class="faq-admin-kpi text-warning" id="kpiDraftCard">—</div>
              <div class="text-muted small">Brouillons</div>
            </div>
          </div>
          <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm text-center py-3">
              <div class="faq-admin-kpi text-info" id="kpiOnSite">—</div>
              <div class="text-muted small">Visibles site</div>
            </div>
          </div>
        </div>

        <!-- Toolbar -->
        <div class="d-flex gap-2 mb-3 flex-wrap">
          <div class="input-group faq-input-max">
            <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
            <input type="search" class="form-control border-start-0" id="faqSearchAdmin" placeholder="Rechercher une question…"/>
          </div>
          <button class="btn btn-primary btn-sm ms-auto" id="btnNewFaq">
            <i class="bi bi-plus-lg me-1"></i>Nouvelle entrée
          </button>
        </div>

        <!-- État loading -->
        <div id="entriesLoading">
          <div class="placeholder-glow">
            <div class="placeholder col-12 rounded mb-2"</div>
            <div class="placeholder col-12 rounded mb-2"</div>
            <div class="placeholder col-12 rounded"</div>
          </div>
        </div>
        <!-- État empty -->
        <div id="entriesEmpty" class="d-none text-center text-muted py-5">
          <i class="bi bi-question-circle fs-1 d-block mb-3"></i>
          <p class="mb-0">Aucune entrée FAQ</p>
        </div>
        <!-- État error -->
        <div id="entriesError" class="d-none text-center text-danger py-5">
          <i class="bi bi-exclamation-triangle fs-1 d-block mb-3"></i>
          <p id="entriesErrorMsg" class="mb-0">Erreur de chargement</p>
          <button class="btn btn-sm btn-outline-danger mt-2" id="btnRetryEntries">
            <i class="bi bi-arrow-clockwise me-1"></i>Réessayer
          </button>
        </div>
        <!-- Table -->
        <div id="entriesTable" class="d-none">
          <div class="card border-0 shadow-sm">
            <div class="table-responsive">
              <table class="table table-hover table-sm mb-0">
                <thead class="table-light">
                  <tr>
                    <th class="faq-th-3rem">Pos.</th>
                    <th>Question</th>
                    <th>Module</th>
                    <th>Statut</th>
                    <th>Visibilité</th>
                    <th>Auteur</th>
                    <th class="faq-th-7rem">Actions</th>
                  </tr>
                </thead>
                <tbody id="entriesTbody"></tbody>
              </table>
            </div>
          </div>
        </div>

      </div>
    </div><!-- /tab-entries -->

    <!-- ── TAB 2 : Brouillons membres (lazy) ── -->
    <div class="tab-pane fade" id="tab-drafts" role="tabpanel">
      <div class="container-fluid p-4">

        <div class="alert alert-info d-flex align-items-center gap-2 mb-4" role="alert">
          <i class="bi bi-info-circle-fill flex-shrink-0"></i>
          <div>Ces questions ont été soumises par des membres. Rédigez la réponse puis publiez.</div>
        </div>

        <!-- État loading -->
        <div id="draftsLoading">
          <div class="placeholder-glow">
            <div class="placeholder col-12 rounded mb-2"</div>
            <div class="placeholder col-12 rounded"</div>
          </div>
        </div>
        <!-- État empty -->
        <div id="draftsEmpty" class="d-none text-center text-muted py-5">
          <i class="bi bi-check-circle fs-1 d-block mb-3 text-success"></i>
          <p class="mb-0">Aucun brouillon en attente</p>
        </div>
        <!-- État error -->
        <div id="draftsError" class="d-none text-center text-danger py-5">
          <i class="bi bi-exclamation-triangle fs-1 d-block mb-3"></i>
          <p id="draftsErrorMsg" class="mb-0">Erreur de chargement</p>
          <button class="btn btn-sm btn-outline-danger mt-2" id="btnRetryDrafts">
            <i class="bi bi-arrow-clockwise me-1"></i>Réessayer
          </button>
        </div>
        <!-- Table -->
        <div id="draftsTable" class="d-none">
          <div class="card border-0 shadow-sm">
            <div class="table-responsive">
              <table class="table table-hover table-sm mb-0">
                <thead class="table-light">
                  <tr>
                    <th>Question soumise</th>
                    <th>Module</th>
                    <th>Soumis par</th>
                    <th class="faq-th-12rem">Actions</th>
                  </tr>
                </thead>
                <tbody id="draftsTbody"></tbody>
              </table>
            </div>
          </div>
        </div>

      </div>
    </div><!-- /tab-drafts -->

  </div><!-- /tab-content -->

      </main>
    </div><!-- /wrapper_content -->

    <footer class="mt-auto py-3 border-top text-center text-muted bg-white">
    <small>&copy; 2026 <span class="app-nom"></span> — CDS Compliant</small>
  </footer>

  </div><!-- /wrapper -->

<!-- ===================== MODAL FORM ===================== -->
<div class="modal fade" id="modalFaqAdmin" tabindex="-1">
  <div class="modal-dialog modal-lg modal-dialog-scrollable">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="faqAdminModalTitle">Nouvelle entrée FAQ</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <div id="faqAdminError" class="alert alert-danger d-none"></div>
        <div class="row g-3">

          <div class="col-12">
            <label class="form-label fw-semibold">Question <span class="text-danger">*</span></label>
            <input type="text" class="form-control" id="faqAdminQuestion" placeholder="Ex: Comment réinitialiser mon mot de passe ?"/>
          </div>

          <div class="col-12">
            <label class="form-label fw-semibold">Réponse <span class="text-muted fw-normal small">(HTML autorisé)</span></label>
            <textarea class="form-control font-monospace small" id="faqAdminReponse" rows="6"
              placeholder="<p>Votre réponse ici.</p>"></textarea>
          </div>

          <div class="col-12 col-sm-6">
            <label class="form-label fw-semibold">Module</label>
            <select class="form-select" id="faqAdminModule">
              <option value="general">Questions générales</option>
              <option value="fiches">Protocoles & fiches</option>
              <option value="transmissions">Transmissions</option>
              <option value="arsenal">Matériel & arsenal</option>
              <option value="annuaire">Annuaire</option>
              <option value="cours">Cours & formation</option>
              <option value="organisateur">Organisateur</option>
            </select>
          </div>

          <div class="col-6 col-sm-3">
            <label class="form-label fw-semibold">Statut</label>
            <select class="form-select" id="faqAdminStatut">
              <option value="active">Actif</option>
              <option value="draft">Brouillon</option>
            </select>
          </div>

          <div class="col-6 col-sm-3">
            <label class="form-label fw-semibold">Position</label>
            <input type="number" class="form-control" id="faqAdminPosition" min="1" value="1"/>
          </div>

          <div class="col-12">
            <label class="form-label fw-semibold">Visibilité</label>
            <div class="d-flex gap-3">
              <div class="form-check">
                <input class="form-check-input" type="checkbox" id="faqAdminShowMod" checked/>
                <label class="form-check-label" for="faqAdminShowMod">Visible dans le module</label>
              </div>
              <div class="form-check">
                <input class="form-check-input" type="checkbox" id="faqAdminShowSite"/>
                <label class="form-check-label" for="faqAdminShowSite">Visible sur le site</label>
              </div>
            </div>
          </div>

          <div class="col-12">
            <div class="border rounded p-3 bg-light">
              <p class="fw-semibold mb-2 small"><i class="bi bi-box-arrow-up-right me-1"></i>CTA (optionnel)</p>
              <div class="row g-2">
                <div class="col-12 col-sm-6">
                  <label class="form-label small">Libellé du bouton</label>
                  <input type="text" class="form-control form-control-sm" id="faqAdminCtaLabel" placeholder="Ex: Voir les fiches"/>
                </div>
                <div class="col-12 col-sm-6">
                  <label class="form-label small">Module cible</label>
                  <select class="form-select form-select-sm" id="faqAdminCtaModule">
                    <option value="">— aucun —</option>
                    <option value="fiches">fiches</option>
                    <option value="transmissions">transmissions</option>
                    <option value="arsenal">arsenal</option>
                    <option value="annuaire">annuaire</option>
                    <option value="cours">cours</option>
                    <option value="organisateur">organisateur</option>
                  </select>
                </div>
              </div>
            </div>
          </div>

        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Annuler</button>
        <button type="button" class="btn btn-primary" id="faqAdminSaveBtn">
          <i class="bi bi-check-lg me-1"></i>Enregistrer
        </button>
      </div>
    </div>
  </div>
</div>

<!-- JS — ordre immuable (BLOC E) -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="../../js/bdb-modal-a11y.js"></script>
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2/dist/umd/supabase.js"></script>
<script src="../../js/supabase-client.js"></script>
<script src="../../js/bdb-ui.js"></script>
<script src="../../js/bdb-invite-guard.js"></script>
<script src="../../js/bdb-shell.js"></script>

<script src="faq-admin.js"></script>
<script>
/* ── Retry buttons (sans handler inline — INTERDIT-CDS) ───────────── */
document.addEventListener('DOMContentLoaded', function () {
  var r1 = document.getElementById('btnRet