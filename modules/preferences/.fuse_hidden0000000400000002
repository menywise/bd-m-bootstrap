<!DOCTYPE html>
<!-- DBM | Surface: MODULE | Auth: bdb-shell.js | Shell: oui -->
<html lang="fr" data-bs-theme="light">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Preferences chirurgien - Des Blocs &amp; Moi</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"/>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet"/>
  <link href="../../css/dbm-theme.css" rel="stylesheet"/>
  <link href="../../css/bdb-ui-kit.css" rel="stylesheet"/>
  <link href="../../css/dbm-module-color.css" rel="stylesheet"/>
  <link href="https://cdnjs.cloudflare.com/ajax/libs/quill/1.3.7/quill.snow.min.css" rel="stylesheet"/>
  <link href="preferences-ui.css" rel="stylesheet"/>
  <style>
    :root {
      --module-color: #93c5fd;
      --module-color-strong: #60a5fa;
      --module-color-text: #1e3a8a;
      --module-color-soft: rgba(147, 197, 253, 0.15);
    }
  </style>
</head>
<body class="sidebar-closed">
  <div id="wrapper">
    <div id="bdb-shell"
         data-module-title="Preferences chirurgiens"
         data-module-icon="bi-person-gear"
         data-root-path="../../"
         data-login-mode="modal"
         data-shell-kind="backoffice"
         data-shell-theme="dbm">
    </div>
    <div id="wrapper_content">
      <div class="app-layout">
        <main class="app-main" id="main-content">
          <div class="app-content" data-module-color="bloc" style="--module-color:#93c5fd;--module-color-strong:#60a5fa;--module-color-text:#1e3a8a;--module-color-soft:rgba(147,197,253,0.15)">
            <section class="app-zone" data-zone="Breadcrumb">
              <nav class="app-breadcrumb" aria-label="Fil d Ariane">
                <a href="../../index.html">Accueil</a>
                <span class="app-breadcrumb-sep"><i class="bi bi-chevron-right"></i></span>
                <span>Preferences chirurgien</span>
              </nav>
            </section>
            <section class="app-zone" data-zone="Page Title">
              <div class="p-4 rounded shadow-sm mb-3 pref-page-banner">
                <h1 class="mb-2 fw-bold"><i class="bi bi-sliders me-2"></i>Preferences chirurgien</h1>
                <p class="mb-0 pref-page-subtitle">Preferences operatoires - globales et par protocole</p>
              </div>
            </section>
            <section class="app-zone" data-zone="Filters">
              <div class="pref-toolbar-bar">
                <div class="d-flex flex-wrap align-items-center gap-2">
                  <div class="input-group input-group-sm pref-toolbar-search">
                    <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                    <input type="search" id="pSearch" class="form-control border-start-0" placeholder="Chirurgien, protocole, mot-cle..." aria-label="Recherche"/>
                  </div>
                  <select id="pGlobal" class="form-select form-select-sm pref-select-180">
                    <option value="">Toutes</option>
                    <option value="true">Globales</option>
                    <option value="false">Par protocole</option>
                    <option value="draft" class="pref-filter-admin d-none">Brouillons a valider</option>
                  </select>
                  <select id="pChirurgien" class="form-select form-select-sm pref-select-180">
                    <option value="">Tous chirurgiens</option>
                  </select>
                  <div class="d-none ms-auto" id="headerAdminSlot"></div>
                  <a href="admin.html" class="btn btn-outline-secondary btn-sm bdb-admin-only d-none">
                    <i class="bi bi-gear me-1"></i>Administration
                  </a>
                </div>
              </div>
            </section>
            <section class="app-zone" data-zone="Content">
              <div id="prefsLoading" class="app-card d-none">
                <div class="app-card-body">
                  <div class="placeholder-glow">
                    <div class="card border-0 shadow-sm mb-3"><div class="card-body"><div class="d-flex align-items-start gap-3">
                      <div class="placeholder rounded-circle pref-chir-avatar"></div>
                      <div class="flex-grow-1"><div class="placeholder col-5 rounded mb-2"></div><div class="placeholder col-3 rounded mb-2"></div><div class="placeholder col-8 rounded"></div></div>
                    </div></div></div>
                    <div class="card border-0 shadow-sm"><div class="card-body"><div class="d-flex align-items-start gap-3">
                      <div class="placeholder rounded-circle pref-chir-avatar"></div>
                      <div class="flex-grow-1"><div class="placeholder col-6 rounded mb-2"></div><div class="placeholder col-4 rounded mb-2"></div><div class="placeholder col-7 rounded"></div></div>
                    </div></div></div>
                  </div>
                </div>
              </div>
              <div id="prefsEmpty" class="app-card d-none">
                <div class="app-card-body app-empty pref-empty-state">
                  <i class="bi bi-person-gear pref-empty-icon"></i>
                  <p class="pref-empty-title">Aucune preference trouvee</p>
                  <small class="pref-empty-help">Les preferences des chirurgiens apparaitront ici.</small>
                  <div class="mt-3">
                    <button class="btn btn-module btn-sm d-none" id="btnNewEmpty">
                      <i class="bi bi-plus-lg me-1"></i>Creer une preference
                    </button>
                  </div>
                </div>
              </div>
              <div id="prefsError" class="app-card d-none">
                <div class="app-card-body app-empty pref-empty-state">
                  <i class="bi bi-wifi-off pref-empty-icon pref-empty-icon--danger"></i>
                  <p class="pref-empty-title">Donnees non chargees</p>
                  <small class="pref-empty-help" id="prefsErrorMsg">La connexion n a pu aboutir - reessayez dans un instant.</small>
                  <div class="mt-3">
                    <button class="btn btn-outline-secondary btn-sm" id="prefsRetryBtn">
                      <i class="bi bi-arrow-clockwise me-1"></i>Reessayer
                    </button>
                  </div>
                </div>
              </div>
              <div id="prefsList"></div>
            </section>
          </div>
          <footer class="app-footer">
            <small>&copy; 2026 <span class="app-nom"></span> - Preferences chirurgien</small>
          </footer>
        </main>
      </div>
    </div>
  </div>
  <div class="modal fade" id="modalPref" tabindex="-1" aria-labelledby="modalPrefLabel">
    <div class="modal-dialog modal-xl modal-dialog-scrollable modal-dialog-centered modal-fullscreen-md-down">
      <div class="modal-content">
        <div class="modal-header modal-header-module">
          <h5 class="modal-title" id="modalPrefLabel">Nouvelle preference chirurgien</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
        </div>
        <div class="modal-body">
          <div id="pFormError" class="alert alert-danger d-none" role="alert"></div>
          <div class="row g-3 mb-3">
            <div class="col-12 d-none" id="pChirurgienRow">
              <label class="form-label fw-semibold small" for="pFormChirurgien">Chirurgien <span class="text-danger">*</span></label>
              <select class="form-select" id="pFormChirurgien"><option value="">- Selectionner un chirurgien -</option></select>
            </div>
            <div class="col-12">
              <label class="form-label fw-semibold small" for="pTitre">Titre <span class="text-danger">*</span></label>
              <input type="text" class="form-control" id="pTitre" placeholder="Ex. Preferences globales - Dr X"/>
            </div>
            <div class="col-12">
              <label class="form-label fw-semibold small">Portee</label>
              <div class="d-flex flex-wrap gap-2 align-items-center">
                <select class="form-select form-select-sm" style="width:240px" id="pScopeLevel">
                  <option value="global">Globale (toutes interventions)</option>
                  <option value="secteur">Par secteur</option>
                  <option value="type">Par type de chirurgie</option>
                  <option value="protocole">Par protocole</option>
                </select>
                <select class="form-select form-select-sm d-none" style="width:180px" id="selScopeSecteur"><option value="">- Secteur -</option></select>
                <select class="form-select form-select-sm d-none" style="width:180px" id="selScopeType"><option value="">- Type -</option></select>
              </div>
              <div class="d-none mt-2" id="pProtoRow">
                <div class="pref-proto-search-wrap">
                  <input type="search" class="form-control form-control-sm" id="pProtoSearch" placeholder="Rechercher protocole par code ou libelle..."/>
                  <div class="pref-proto-dropdown" id="pProtoResults"></div>
                </div>
                <div class="mt-1" id="pProtoSelected"></div>
              </div>
            </div>
          </div>
          <div class="accordion" id="prefAccordion">
            <div class="acc-item accordion-item border-0">
              <h2 class="accordion-header">
                <button class="accordion-button collapsed py-2" type="button" data-bs-toggle="collapse" data-bs-target="#accOuvSalle">
                  <span class="pref-acc-icon pref-acc-icon-ouv"><i class="bi bi-door-open"></i></span>
                  <span class="small fw-semibold">Ouverture de salle</span>
                </button>
              </h2>
              <div id="accOuvSalle" class="accordion-collapse collapse">
                <div class="accordion-body pt-2">
                  <div class="pref-sub-item">
                    <div class="form-check form-switch mb-0">
                      <input class="form-check-input" type="checkbox" id="togBE" role="switch"/>
                      <label class="form-check-label pref-sub-label" for="togBE"><i class="bi bi-lightning-charge text-warning me-1"></i>Bistouri electrique</label>
                    </div>
                    <div class="sub" id="beSub">
                      <div class="row g-2 mb-2">
                        <div class="col-6"><span class="pref-fl">Modele</span><select class="form-select form-select-sm" id="selBEModele"><option value="">-</option></select></div>
                        <div class="col-6"><span class="pref-fl">Position en salle</span><select class="form-select form-select-sm" id="selBEPos"><option value="">-</option></select></div>
                      </div>
                      <div class="be-tabs">
                        <button type="button" class="be-tab active" data-be="coupe">Coupe</button>
                        <button type="button" class="be-tab" data-be="coag">Coagulation</button>
                        <button type="button" class="be-tab" data-be="bipo">Bipolaire</button>
                      </div>
                      <div id="beCoupe" class="be-pnl on">
                        <div class="be-rng mb-1"><span class="pref-fl mb-0 me-2">Puissance</span><input type="range" min="40" max="150" step="5" value="80" id="rCoupe"/><div class="be-val" id="vCoupe">80 W</div></div>
                        <span class="pref-fl">Mode</span><select class="form-select form-select-sm w-auto" id="selCoupeMode"><option value="">-</option></select>
                      </div>
                      <div id="beCoag" class="be-pnl">
                        <div class="be-rng mb-1"><span class="pref-fl mb-0 me-2">Puissance</span><input type="range" min="40" max="150" step="5" value="80" id="rCoag"/><div class="be-val" id="vCoag">80 W</div></div>
                        <span class="pref-fl">Mode</span><select class="form-select form-select-sm w-auto" id="selCoagMode"><option value="">-</option></select>
                      </div>
                      <div id="beBipo" class="be-pnl">
                        <div class="form-check form-switch mb-1"><input class="form-check-input" type="checkbox" id="togBipo" role="switch"/><label class="form-check-label small" for="togBipo">Bipolaire utilise</label></div>
                        <div class="sub" id="bipoSub">
                          <div class="be-rng mb-1"><span class="pref-fl mb-0 me-2">Puissance</span><input type="range" min="15" max="80" step="5" value="15" id="rBipo"/><div class="be-val" id="vBipo">15 W</div></div>
                          <span class="pref-fl">Mode</span><select class="form-select form-select-sm w-auto" id="selBipoMode"><option value="">-</option></select>
                          <textarea class="form-control form-control-sm mt-2" id="inpCmtBipo" rows="1" placeholder="Commentaire bipolaire..."></textarea>
                        </div>
                      </div>
                      <textarea class="form-control form-control-sm mt-2" id="inpCmtBE" rows="2" placeholder="Commentaire bistouri..."></textarea>
                    </div>
                  </div>
                  <div class="pref-sub-item">
                    <div class="form-check form-switch mb-0">
                      <input class="form-check-input" type="checkbox" id="togNeptune" role="switch"/>
                      <label class="form-check-label pref-sub-label" for="togNeptune"><i class="bi bi-water text-info me-1"></i>Neptune</label>
                    </div>
                    <div class="sub" id="neptuneSub"><textarea class="form-control form-control-sm" id="inpCmtNeptune" rows="2" placeholder="Commentaire Neptune..."></textarea></div>
                  </div>
                  <div class="pref-sub-item">
                    <div class="form-check form-switch mb-0">
                      <input class="form-check-input" type="checkbox" id="togGarrot" role="switch"/>
                      <label class="form-check-label pref-sub-label" for="togGarrot"><i class="bi bi-bandaid text-danger me-1"></i>Garrot pneumatique</label>
                    </div>
                    <div class="sub" id="garrotSub">
                      <div class="row g-2 mb-2">
                        <div class="col-md-4"><span class="pref-fl">Position</span><select class="form-select form-select-sm" id="selGarrotPos"><option value="">-</option></select></div>
                        <div class="col-md-4"><span class="pref-fl">Pression (mmHg)</span><input type="number" class="form-control form-control-sm" id="inpGarrotPression" placeholder="ex. 300" min="100" max="500" step="10"/></div>
                        <div class="col-md-4"><span class="pref-fl">Duree max (min)</span><input type="number" class="form-control form-control-sm" id="inpGarrotDuree" placeholder="ex. 90" min="10" max="240" step="5"/></div>
                      </div>
                      <textarea class="form-control form-control-sm" id="inpCmtGarrot" rows="2" placeholder="Commentaire garrot..."></textarea>
                    </div>
                  </div>
                  <div class="pref-sub-item">
                    <div class="form-check form-switch mb-0"><input class="form-check-input" type="checkbox" id="togColonneArthro" role="switch"/><label class="form-check-label pref-sub-label" for="togColonneArthro">Colonne arthro</label></div>
                    <div class="sub" id="colonneArthroSub"><textarea class="form-control form-control-sm" id="inpCmtColonneArthro" rows="2" placeholder="Commentaire colonne arthro..."></textarea></div>
                  </div>
                  <div class="pref-sub-item">
                    <div class="form-check form-switch mb-0"><input class="form-check-input" type="checkbox" id="togTablePont" role="switch"/><label class="form-check-label pref-sub-label" for="togTablePont">Table pont</label></div>
                    <div class="sub" id="tablePontSub"><textarea class="form-control form-control-sm" id="inpCmtTablePont" rows="2" placeholder="Commentaire table pont..."></textarea></div>
                  </div>
                  <div class="pref-sub-item">
                    <div class="form-check form-switch mb-0"><input class="form-check-input" type="checkbox" id="togTableBras" role="switch"/><label class="form-check-label pref-sub-label" for="togTableBras">Table a bras</label></div>
                    <div class="sub" id="tableBrasSub"><textarea class="form-control form-control-sm" id="inpCmtTableBras" rows="2" placeholder="Commentaire table a bras..."></textarea></div>
                  </div>
                  <div class="pref-sub-item">
                    <div class="form-check form-switch mb-0"><input class="form-check-input" type="checkbox" id="togTablette" role="switch"/><label class="form-check-label pref-sub-label" for="togTablette">Tablette</label></div>
                    <div class="sub" id="tabletteSub"><textarea class="form-control form-control-sm" id="inpCmtTablette" rows="2" placeholder="Commentaire tablette..."></textarea></div>
                  </div>
                  <div class="pref-sub-item">
                    <div class="form-check form-switch mb-0"><input class="form-check-input" type="checkbox" id="togBureau" role="switch"/><label class="form-check-label pref-sub-label" for="togBureau">Bureau - tabouret - ordinateur</label></div>
                    <div class="sub" id="bureauSub"><textarea class="form-control form-control-sm" id="inpCmtBureau" rows="2" placeholder="Commentaire bureau..."></textarea></div>
                  </div>
                </div>
              </div>
            </div>
            <div class="acc-item accordion-item border-0">
              <h2 class="accordion-header">
                <button class="accordion-button collapsed py-2" type="button" data-bs-toggle="collapse" data-bs-target="#accAmpli">
                  <span class="pref-acc-icon pref-acc-icon-ampli"><i class="bi bi-camera-reels"></i></span>
                  <span class="small fw-semibold">Amplificateur de brillance</span>
                </button>
              </h2>
              <div id="accAmpli" class="accordion-collapse collapse">
                <div class="accordion-body pt-2">
                  <div class="form-check form-switch mb-1"><input class="form-check-input" type="checkbox" id="togAmpli" role="switch"/><label class="form-check-label small" for="togAmpli">Present</label></div>
                  <div class="sub" id="ampliSub">
                    <div class="mb-2">
                      <span class="pref-fl">Taille</span>
                      <div class="pref-chip-wrap">
                        <input class="pref-chip" type="radio" name="grpAmpliTaille" id="chipAmpliPetit" value="Petit"/><label class="pref-chip-label" for="chipAmpliPetit">Petit</label>
                        <input class="pref-chip" type="radio" name="grpAmpliTaille" id="chipAmpliGrand" value="Grand"/><label class="pref-chip-label" for="chipAmpliGrand">Grand</label>
                      </div>
                    </div>
                    <div class="mb-2">
                      <span class="pref-fl">Position en salle</span>
                      <select class="form-select form-select-sm w-auto" id="selAmpliPos"><option value="">-</option></select>
                    </div>
                    <div class="form-check form-switch mb-1"><input class="form-check-input" type="checkbox" id="togPedaleAmpli" role="switch"/><label class="form-check-label small" for="togPedaleAmpli">Pedale</label></div>
                    <div class="sub" id="pedaleAmpliSub"><textarea class="form-control form-control-sm" id="inpCmtPedaleAmpli" rows="2" placeholder="Commentaire pedale..."></textarea></div>
                    <div class="form-check form-switch mb-1"><input class="form-check-input" type="checkbox" id="togResumeDose" role="switch"/><label class="form-check-label small" for="togResumeDose">Resume de dose</label></div>
                    <div class="sub" id="resumeDoseSub"><textarea class="form-control form-control-sm" id="inpCmtResumeDose" rows="2" placeholder="Commentaire resume de dose..."></textarea></div>
                    <div class="form-check form-switch mb-1"><input class="form-check-input" type="checkbox" id="togImages" role="switch"/><label class="form-check-label small" for="togImages">Images</label></div>
                    <div class="sub" id="imagesSub">
                      <span class="pref-fl">Incidences</span>
                      <div class="pref-chip-wrap mb-2">
                        <input class="pref-chip" type="checkbox" name="grpAmpliImgFace" id="chipImgFace" value="Face"/><label class="pref-chip-label" for="chipImgFace">Face</label>
                        <input class="pref-chip" type="checkbox" name="grpAmpliImgFace" id="chipImgProfil" value="Profil"/><label class="pref-chip-label" for="chipImgProfil">Profil</label>
                      </div>
                      <textarea class="form-control form-control-sm" id="inpCmtImages" rows="2" placeholder="Commentaire images..."></textarea>
                    </div>
                    <textarea class="form-control form-control-sm mt-2" id="inpCmtAmpli" rows="2" placeholder="Commentaire amplificateur..."></textarea>
                  </div>
                </div>
              </div>
            </div>
            <div class="acc-item accordion-item border-0">
              <h2 class="accordion-header">
                <button class="accordion-button collapsed py-2" type="button" data-bs-toggle="collapse" data-bs-target="#accHabillage">
                  <span class="pref-acc-icon pref-acc-icon-hab"><i class="bi bi-person-badge"></i></span>
                  <span class="small fw-semibold">Habillage</span>
                </button>
              </h2>
              <div id="accHabillage" class="accordion-collapse collapse">
                <div class="accordion-body pt-2">
                  <div class="mb-3">
                    <span class="pref-fl">1re paire de gants</span>
                    <div class="row g-2">
                      <div class="col-4"><select class="form-select form-select-sm" id="selG1Taille"><option value="">- Taille -</option><option>5.5</option><option>6</option><option>6.5</option><option>7</option><option>7.5</option><option>8</option><option>8.5</option><option>9</option></select></div>
                      <div class="col-8"><select class="form-select form-select-sm" id="selG1Modele"><option value="">- Modele -</option></select></div>
                    </div>
                  </div>
                  <div class="form-check form-switch mb-1"><input class="form-check-input" type="checkbox" id="togGants2" role="switch"/><label class="form-check-label small" for="togGants2">2e paire differente</label></div>
                  <div class="sub" id="gants2Sub">
                    <div class="row g-2 mb-2">
                      <div class="col-4"><select class="form-select form-select-sm" id="selG2Taille"><option value="">- Taille -</option><option>5.5</option><option>6</option><option>6.5</option><option>7</option><option>7.5</option><option>8</option><option>8.5</option></select></div>
                      <div class="col-8"><select class="form-select form-select-sm" id="selG2Modele"><option value="">- Modele -</option></select></div>
                    </div>
                    <textarea class="form-control form-control-sm" id="inpCmtGants2" rows="2" placeholder="Commentaire 2e paire..."></textarea>
                  </div>
                  <div class="row g-2 mb-2 mt-2">
                    <div class="col-6"><span class="pref-fl">Type casaque</span><select class="form-select form-select-sm" id="selCasaqueType"><option value="">-</option></select></div>
                    <div class="col-6"><span class="pref-fl">Taille casaque</span><select class="form-select form-select-sm" id="selCasaqueTaille"><option value="">-</option><option>XS</option><option>S</option><option>M</option><option>L</option><option>XL</option><option>XXL</option></select></div>
                  </div>
                  <div class="form-check form-switch mb-1"><input class="form-check-input" type="checkbox" id="togCasque" role="switch"/><label class="form-check-label small" for="togCasque">Casque sterile</label></div>
                  <div class="sub" id="casqueSub"><textarea class="form-control form-control-sm" id="inpCmtCasque" rows="2" placeholder="Commentaire casque..."></textarea></div>
                </div>
              </div>
            </div>
            <div class="acc-item accordion-item border-0">
              <h2 class="accordion-header">
                <button class="accordion-button collapsed py-2" type="button" data-bs-toggle="collapse" data-bs-target="#accInstall">
                  <span class="pref-acc-icon pref-acc-icon-install"><i class="bi bi-person-standing"></i></span>
                  <span class="small fw-semibold">Installation patient</span>
                </button>
              </h2>
              <div id="accInstall" class="accordion-collapse collapse">
                <div class="accordion-body pt-2">
                  <div class="mb-3">
                    <span class="pref-fl">Table operatoire</span>
                    <div class="pref-chip-wrap mb-2">
                      <input class="pref-chip" type="radio" name="grpTable" id="chipTblStryker" value="Stryker"/><label class="pref-chip-label" for="chipTblStryker">Stryker</label>
                      <input class="pref-chip" type="radio" name="grpTable" id="chipTblPlateau" value="Plateau"/><label class="pref-chip-label" for="chipTblPlateau">Plateau</label>
                      <input class="pref-chip" type="radio" name="grpTable" id="chipTblEpaule" value="Table d epaule"/><label class="pref-chip-label" for="chipTblEpaule">Table d epaule</label>
                    </div>
                    <div class="d-none" id="plateauVarianteRow">
                      <span class="pref-fl">Variante plateau</span>
                      <div class="pref-chip-wrap mb-2">
